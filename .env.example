# --- Database ---
POSTGRES_PASSWORD=your-secure-password-here

# --- Sessions ---
# Long random string. Rotating this invalidates all active UI sessions.
SELFMEM_SESSION_SECRET=change-me-in-production
SELFMEM_SESSION_MAX_AGE=86400

# --- Hosting mode ---
# 'selfhosted' (default): no quotas, no billing, all features unlimited.
# 'saas':       enforces free-tier quotas, exposes billing UI, rate-limits API keys.
SELFMEM_HOSTING_MODE=selfhosted

# --- Free-tier limits (only enforced when HOSTING_MODE=saas) ---
SELFMEM_FREE_MEMORY_LIMIT=100
SELFMEM_FREE_PROJECT_LIMIT=1
SELFMEM_FREE_MEMBER_LIMIT=1
SELFMEM_FREE_API_LIMIT_DAILY=100
SELFMEM_PAID_API_LIMIT_DAILY=10000

# --- Public URL (used in invitation + password-reset emails) ---
SELFMEM_PUBLIC_URL=http://localhost:8818

# --- Server ---
SELFMEM_HOST=0.0.0.0
SELFMEM_PORT=8818

# --- Embeddings ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# --- Database reset (DESTRUCTIVE) ---
# Set to 'true' once to drop all tables and recreate fresh schema. Then unset.
# Do NOT leave this enabled across deploys.
SELFMEM_RESET_DATABASE=false

# --- SMTP (phase 3 — leave empty to disable email) ---
SELFMEM_SMTP_HOST=
SELFMEM_SMTP_PORT=587
SELFMEM_SMTP_USER=
SELFMEM_SMTP_PASSWORD=
SELFMEM_SMTP_FROM=noreply@selfmem.local

# --- Stripe (phase 4 — leave empty to disable billing) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLIC_KEY=
STRIPE_UNLIMITED_PRICE_ID=
